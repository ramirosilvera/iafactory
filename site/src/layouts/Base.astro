---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Tablero remoto de la IA Factory." } = Astro.props;
const B = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · IA Factory</title>
    <meta name="description" content={description} />
    <!-- S8: limita de dónde puede cargar código y a quién puede conectarse la página. -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'" />
    <meta name="theme-color" content="#0a0e1a" />
    <!-- Panel privado: no se indexa. -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- "default" (no black-translucent): la paleta es clara, y con
         black-translucent los glifos de la status bar de iOS quedan blancos
         e ilegibles. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="IA Factory" />
    <link rel="manifest" href={`${B}manifest.webmanifest`} />
    <link rel="icon" href={`${B}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${B}apple-touch-icon.png`} />
  </head>
  <body>
    <slot />
    <div id="update-banner" class="update-banner" hidden>
      <span>Hay una versión nueva de IA Factory.</span>
      <button type="button" onclick="location.reload()">Actualizar</button>
    </div>
    <script>
      if ("serviceWorker" in navigator) {
        // sw.js toma control solo (skipWaiting + clients.claim), pero el
        // HTML/JS en memoria sigue siendo el viejo hasta recargar:
        // "controllerchange" avisa y el usuario recarga cuando quiera.
        const teniaControlador = Boolean(navigator.serviceWorker.controller);
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (!teniaControlador) return; // primera instalación
          const banner = document.getElementById("update-banner");
          if (!banner) return;
          banner.hidden = false;
          document.body.classList.add("tiene-aviso-actualizacion");
        });
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).then((reg) => {
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") reg.update().catch(() => {});
          });
        }).catch(() => {});
      }
    </script>
  </body>
</html>
