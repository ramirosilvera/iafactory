---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** "fabrica" = tablero remoto de la IA Factory: su propia identidad (nombre, ícono, manifest, sin la barra de Mi ropa, sin indexar). */
  marca?: "miropa" | "fabrica";
}

const { title, marca = "miropa" } = Astro.props;
const esFabrica = marca === "fabrica";
const nombreApp = esFabrica ? "IA Factory" : "Mi ropa";
const description = Astro.props.description ?? (esFabrica ? "Tablero remoto de la IA Factory." : "Mi ropa — tu estilista que te explica por qué combina.");
const B = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
// new URL(path, Astro.site), no concatenación de strings -- Astro.site ya
// viene con "/" final (normalizado por Astro), así que sumarlo a mano con
// BASE_URL (que también arranca con "/") daba una barra doble
// ("https://.../miropa/og-image.png" -> ".io//miropa/..."),
// confirmado mirando el HTML generado por el build.
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.png`, Astro.site).toString();
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {nombreApp}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={esFabrica ? "#211a15" : "#c8763f"} />
    {esFabrica && <meta name="robots" content="noindex, nofollow" />}
    <!-- Open Graph / Twitter Card -- antes no existían: compartir un link de
         la app (WhatsApp, Twitter, etc.) no mostraba ninguna preview, pese a
         que ya había un og-image.png en public/ sin usar en ningún lado. -->
    {!esFabrica && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:title" content={`${title} · Mi ropa`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:url" content={canonicalUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={`${title} · Mi ropa`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <!-- iOS 16.4+ ya honra display:standalone del manifest -- estos tags son
         compatibilidad para versiones previas y para fijar explícitamente el
         estilo de status bar. "default" (no black-translucent): con
         black-translucent la status bar dibuja sus glifos (hora, batería,
         señal) SIEMPRE en blanco, y la paleta de esta app es clara y sin modo
         oscuro (--bg: #fbf7f2) -- quedarían ilegibles. Con "default" iOS
         reserva la barra como opaca y empuja el contenido debajo solo. -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={esFabrica ? "Fábrica" : "Mi ropa"} />
    <link rel="manifest" href={`${B}${esFabrica ? "fabrica.webmanifest" : "manifest.webmanifest"}`} />
    <link rel="icon" href={`${B}${esFabrica ? "fabrica-favicon-32.png" : "favicon-32.png"}`} />
    <link rel="apple-touch-icon" href={`${B}${esFabrica ? "fabrica-apple-touch-icon.png" : "apple-touch-icon.png"}`} />
  </head>
  <body class={esFabrica ? "marca-fabrica" : undefined}>
    <slot />
    <div id="miropa-update-banner" class="update-banner" hidden>
      <span>Hay una versión nueva de {nombreApp}.</span>
      <button type="button" onclick="location.reload()">Actualizar</button>
    </div>
    <!-- Pedido explícito del usuario: "que la sección de inicio sea
         outfit... revisá el resto del orden para que haya una línea y
         tengan sentido". Orden nuevo -- una narrativa de uso real, no
         alfabético ni el orden histórico en que se fueron agregando las
         pantallas:
         1. Outfits (ahora la home, "/") -- la acción del día a día:
            vestirte hoy con lo que ya tenés.
         2. Placard -- tu guardarropa completo, lo que Outfits usa.
         3. + Prenda -- sumar algo nuevo a ese guardarropa.
         4. Probar -- decidir si comprar algo TODAVÍA no cargado.
         5. Estadísticas -- una vista de análisis/reportes, al final a
            propósito (no es una acción del día a día como las anteriores).
         Placard se mudó de "/" a "/placard/" -- Outfits toma la home. -->
    {!esFabrica && (
      <nav class="tabbar">
        <a href={import.meta.env.BASE_URL} class={path === import.meta.env.BASE_URL ? "active" : ""}>Outfits</a>
        <a
          href={`${import.meta.env.BASE_URL}placard/`}
          class={path.includes("/placard/") || path.includes("/combinar/") ? "active" : ""}
        >
          Placard
        </a>
        <a href={`${import.meta.env.BASE_URL}prenda/nueva/`} class={path.includes("/prenda/") ? "active" : ""}>+ Prenda</a>
        <a href={`${import.meta.env.BASE_URL}probar/`} class={path.includes("/probar/") ? "active" : ""}>Probar</a>
        <a href={`${import.meta.env.BASE_URL}estadisticas/`} class={path.includes("/estadisticas/") ? "active" : ""}>Estadísticas</a>
        <a href={`${import.meta.env.BASE_URL}fabrica/`} class={path.includes("/fabrica/") ? "active" : ""}>Fábrica</a>
      </nav>
    )}
    <script>
      if ("serviceWorker" in navigator) {
        // sw.js llama a skipWaiting()+clients.claim() sin pedir permiso, así
        // que un service worker nuevo toma control de la pestaña ya abierta
        // solo -- pero el HTML/JS que está en memoria en ESE momento sigue
        // siendo el viejo hasta recargar. Es justo el bug reportado: una app
        // ya abierta (o una PWA instalada que no se cerró del todo) se queda
        // corriendo la versión de antes de un deploy y una feature nueva
        // (como el botón de eliminar prenda) no aparece hasta refrescar.
        // "controllerchange" avisa de eso; no se recarga sola para no
        // interrumpir algo que el usuario esté completando (ej. el form de
        // cargar una prenda).
        const teniaControlador = Boolean(navigator.serviceWorker.controller);
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (!teniaControlador) return; // primera instalación, no una actualización real
          const banner = document.getElementById("miropa-update-banner");
          if (!banner) return;
          banner.hidden = false;
          // el body necesita el mismo espacio reservado arriba que el
          // banner, si no tapa el título de la pantalla (ver .update-banner
          // y body.tiene-aviso-actualizacion en global.css).
          document.body.classList.add("tiene-aviso-actualizacion");
        });
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`).then((reg) => {
          // el chequeo automático del navegador no es predecible en todos
          // los contextos (PWA standalone en background, etc.) -- forzar un
          // chequeo cuando la pestaña vuelve a primer plano es lo que más
          // ataca el escenario real: la app quedó abierta desde antes de un
          // deploy y no se refrescó sola.
          document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") reg.update().catch(() => {});
          });
        }).catch(() => {});
      }
    </script>
  </body>
</html>
